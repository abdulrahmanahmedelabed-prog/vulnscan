// @id vql/cors-credentials-any-origin
// @name CORS allows any origin together with credentials
// @name_ar CORS يسمح بأي أصل مع بيانات الاعتماد
// @severity high
// @cwe CWE-942
// @advice لا تجمع بين أي أصل وبيانات الاعتماد؛ حدّد قائمة بيضاء من الأصول الموثوقة.
from call c
where (c.name matches "(^|\.)CORS$" and c.kwargs contains "supports_credentials=True" and not c.kwargs matches "(^|, )(origins|resources)=")
   or (c.name matches "\.add_middleware$" and c.arg0 matches "CORSMiddleware$" and c.kwargs contains "allow_credentials=True" and c.kwargs matches "allow_origins=\[\s*['\"]\*['\"]\s*\]|allow_origin_regex=r?['\"]\.\*")
   or (c.name = "cors" and c.arg0 matches "['\"]credentials['\"]: True" and c.arg0 matches "['\"]origin['\"]: (True|['\"]\*['\"])")
select c, "CORS accepts any origin with credentials in " + c.name
