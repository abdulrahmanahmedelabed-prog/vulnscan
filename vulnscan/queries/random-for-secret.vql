// @id vql/random-for-secret
// @name Non-cryptographic random used for a secret value
// @name_ar عشوائية غير مشفّرة لقيمة حساسة
// @severity medium
// @cwe CWE-338
// @advice استخدم secrets (Python) أو crypto.randomBytes (Node) للرموز وكلمات المرور.
from assign a
where a.target matches "(?i)(token|secret|password|otp|nonce|salt|session|csrf|api_key)" and a.value matches "random\.(random|randint|choice|choices|randrange|getrandbits|uniform)\(|Math\.random"
select a, "Secret-like value " + a.target + " built from a non-cryptographic random"
