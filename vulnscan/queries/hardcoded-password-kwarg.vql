// @id vql/hardcoded-password-kwarg
// @name Password or secret passed as a string literal keyword argument
// @name_ar كلمة مرور أو سر مُمرَّر كوسيط نصي حرفي
// @severity high
// @cwe CWE-798
// @advice اقرأ الأسرار من متغيرات البيئة أو مدير أسرار.
from call c
where c.kwargs matches "(?i)(password|passwd|secret|token|api_key|apikey)=['\"][^'\"]{4,}['\"]" and not c.kwargs matches "(?i)(example|placeholder|changeme|dummy|test|xxx)"
select c, "Hard-coded secret keyword argument in " + c.name
