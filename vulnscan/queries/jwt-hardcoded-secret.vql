// @id vql/jwt-hardcoded-secret
// @name JWT signed or verified with a hard-coded secret
// @name_ar توقيع JWT أو التحقق منه بسرّ مكتوب في الكود
// @severity high
// @cwe CWE-798
// @advice اقرأ مفتاح التوقيع من مدير أسرار أو متغير بيئة، وأصدر مفتاحًا جديدًا إن كان حقيقيًا.
from call c
where ((c.name matches "^(jwt|jsonwebtoken)\.(sign|verify)$" and c.arg1 matches "^['\"`][^'\"`]{3,}")
    or (c.name matches "^(jwt|jose\.jwt)\.(encode|decode)$" and c.arg1 matches "^['\"][^'\"]{3,}"))
  and not c.arg1 matches "-----BEGIN (RSA )?PUBLIC KEY-----|-----BEGIN CERTIFICATE-----"
select c, "Hard-coded JWT key in " + c.name
