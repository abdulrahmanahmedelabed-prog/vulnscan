// @id vql/entry-point-without-auth
// @name Routed entry point without an authentication decorator
// @name_ar نقطة دخول مُوجَّهة بلا مُزخرِف مصادقة
// @severity info
// @cwe CWE-306
// @advice تأكد أن المسار عام عن قصد، وإلا أضف مصادقة (login_required، jwt_required، guard…).
from func f
where f.is_entry and f.decorators matches "(^|[.\\s,])(route|api_route|get|post|put|delete|patch|Get|Post|Put|Delete|Patch|HttpGet|HttpPost|HttpPut|HttpDelete|HttpPatch|RequestMapping|GetMapping|PostMapping|PutMapping|DeleteMapping|PatchMapping)($|,)" and not f.decorators matches "(?i)login|logged|auth|jwt|permission|protected|guard|roles|csrf|passport|session|ensure|require_?user|verify|token|acl|policy|admin|signed_?in|current_?user|secure|access"
select f, "Entry point " + f.name + " has no authentication decorator"
